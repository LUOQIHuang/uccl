# test/ dev workspace: track only source/scripts, exclude large local artifacts
test/**/venv*/
test/**/venv-*/
test/**/tree/
test/**/current-test/
test/**/python/cpython-*/
test/**/tools/uv-*/
test/**/*.log
test/**/*.pid
test/**/*.status
test/**/._*
test/**/*.o
test/**/*.so
test/**/*.a
test/**/*.bin

# Benchmark result logs (explicitly tracked, labeled by node)
!test/bench_results/**/*.log

# Verbs diagnostics: share small, selected results alongside logs.
!test/bench_results/verbs_diag/**/*.json
!test/bench_results/verbs_diag/**/*.jsonl
!test/bench_results/verbs_diag/**/*.csv

# URMA diagnostics use the same selected result format.
!test/bench_results/urma_diag/**/*.json
!test/bench_results/urma_diag/**/*.jsonl
!test/bench_results/urma_diag/**/*.csv

# Fresh wire-v2 builds remain on servers; share selected validation results.
!test/bench_results/urma_mode_parity/**/*.json
!test/bench_results/urma_mode_parity/**/*.jsonl
!test/bench_results/urma_mode_parity/**/*.csv

# Mode/stage results shared at the team's established results location.
!test/urma_mode_parity/results/**/*.log
!test/urma_mode_parity/results/**/*.csv
!test/urma_mode_parity/results/**/*.json
!test/urma_mode_parity/results/**/*.jsonl

# Fixed verbs Normal/LL baselines and separate GPU traces.
!test/verbs_baseline/results/**/*.log
!test/verbs_baseline/results/**/*.json
!test/verbs_baseline/results/**/*.jsonl
!test/verbs_baseline/results/**/*.csv
